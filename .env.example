# Copie para ".env" na pasta do projeto (já ignorado pelo git) ou para ~/agent-secrets/estudos.env.
#
#   cp .env.example .env
#
# Se existir os dois, o ".env" da pasta do projeto vence.
# Nunca commite este arquivo com valores reais.

# Obrigatória. Crie em https://console.anthropic.com/settings/keys. Paga as chamadas dos
# agentes. Trate como senha.
ANTHROPIC_API_KEY=

# Opcional. Pasta onde ficam fotos, notas geradas, cache, logs e estado.
# Padrão: ~/agent-data. CLASS2MD_HOME e AGENT_DATA_DIR são equivalentes.
# CLASS2MD_HOME=

# Opcionais. Por padrão derivam da pasta de dados.
# STAGING_DIR=
# CACHE_DIR=
# LOGS_DIR=

# Teto mensal de referência, em dólares. O comando `custos` compara o gasto com este valor,
# mas não bloqueia chamadas. Configure também um limite na console da Anthropic.
TETO_MENSAL_USD=10

# Teto de tokens de saída do agente que compõe a nota.
MAX_TOKENS_COMPOSITOR=8192
